# ============================
#Exercise 2
# ============================
# ====== IMPORT======
set workdir "/Users/ale/Desktop/University"
open "Bonfiglio_Alessandro.xlsx" --sheet="Foglio2" --quiet
# --- Costruzione rendimenti da log-prezzi ---
series r1 = diff(log(Price1))
series r2 = diff(log(Price2))
series r3 = diff(log(Price3))

printf "\n================ Descriptive statistics rendimenti ================\n"
summary r1 
summary r2
summary r3
# ================= DIAGNOSTICA PRELIMINARE =================
printf "\n================ Diagnostica preliminare ================\n"

# Grafici base
gnuplot r1 --with-lines --time-series --output=display 
gnuplot r2 --with-lines --time-series --output=display 
gnuplot r3 --with-lines --time-series --output=display 
qqplot r1  --output=display 
qqplot r2  --output=display 
qqplot r3  --output=display 

# ACF rendimenti e ACF dei quadrati
corrgm r1 20 --plot=display
corrgm r2 20 --plot=display
corrgm r3 20 --plot=display

# Skewness e Kurtosis
scalar sk1  = skewness(r1)
scalar kt1  = kurtosis(r1)
scalar sk2  = skewness(r2)
scalar kt2  = kurtosis(r2)
scalar sk3  = skewness(r3)
scalar kt3  = kurtosis(r3)
printf "\nSkewness  = %.4f\n", sk1
printf "Kurtosis  = %.4f  \n", kt1
printf "\nSkewness2  = %.4f\n", sk2
printf "Kurtosis2  = %.4f \n", kt2
printf "\nSkewness3  = %.4f\n", sk3
printf "Kurtosis2  = %.4f \n", kt3

# Liung-Box manuale
scalar R1 =ljungbox(r1, 20)
scalar pval1= pvalue(X,20,R1)
printf "ljungbox Q=%.4f, pvalue=%.4f\n", R1, pval1
scalar R2 =ljungbox(r2, 20)
scalar pval2= pvalue(X,20,R2)
printf "ljungbox Q=%.4f, pvalue=%.4f\n", R2, pval2
scalar R3 =ljungbox(r3, 20)
scalar pval3= pvalue(X,20,R3)
printf "ljungbox Q=%.4f, pvalue=%.4f\n", R3, pval3

normtest r1 --jbera
normtest r2 --jbera
normtest r3 --jbera

# ============================
# EWMA multivariato 
# ============================

scalar lambda = 0.94
scalar alpha  = 1 - lambda   # = 0.06 se lambda=0.94

smpl ok(r1) && ok(r2) && ok(r3) --restrict

scalar v1  = var(r1)
scalar v2  = var(r2)
scalar v3  = var(r3)
scalar c12 = cov(r1, r2)
scalar c13 = cov(r1, r3)
scalar c23 = cov(r2, r3)

# Serie per salvare i risultati (varianze, covarianze)
series V1  = NA
series V2  = NA
series V3  = NA
series C12 = NA
series C13 = NA
series C23 = NA

V1[$t1]  = v1
V2[$t1]  = v2
V3[$t1]  = v3
C12[$t1] = c12
C13[$t1] = c13
C23[$t1] = c23

# Ricorsione EWMA multivariata:
# S_t = lambda*S_{t-1} + alpha * u_{t-1} u_{t-1}'
loop i=($t1+1)..$t2
    v1  = lambda*v1  + alpha*(r1[i-1])^2
    v2  = lambda*v2  + alpha*(r2[i-1])^2
    v3  = lambda*v3  + alpha*(r3[i-1])^2
    c12 = lambda*c12 + alpha*(r1[i-1]*r2[i-1])
    c13 = lambda*c13 + alpha*(r1[i-1]*r3[i-1])
    c23 = lambda*c23 + alpha*(r2[i-1]*r3[i-1])

    V1[i]  = v1
    V2[i]  = v2
    V3[i]  = v3
    C12[i] = c12
    C13[i] = c13
    C23[i] = c23
endloop

series S1 = sqrt(V1)
series S2 = sqrt(V2)
series S3 = sqrt(V3)

# Correlazioni dinamiche: rho_ij,t = cov_ij,t / (sigma_i,t * sigma_j,t)
series rho12 = C12 / (S1*S2)
series rho13 = C13 / (S1*S3)
series rho23 = C23 / (S2*S3)

gnuplot S1 S2 S3 --time-series --with-lines --output=display
gnuplot rho12 rho13 rho23 --time-series --with-lines --output=display

#=======DCC===============

smpl ok(r1) && ok(r2) && ok(r3) --restrict
set verbose off  
include DCC.gfn

garch 1 1 ; r1 const --robust --stdresid
series h_r1 = $h
series et_r1 = $uhat
series st1=et_r1/sqrt(h_r1)
garch 1 1 ; r2 const --robust --stdresid
series h_r2 = $h
series et_r2 = $uhat
series st2=et_r2/sqrt(h_r2)
garch 1 1 ; r3 const --robust  --stdresid
series h_r3 = $h
series et_r3 = $uhat
series st3=et_r3/sqrt(h_r3)
list E = et_r1 et_r2 et_r3
list H = h_r1 h_r2 h_r3

# Test diagnostici sui residui standardizzati
corrgm st1 10 --plot=display
corrgm st2 10 --plot=display
corrgm st3 10 --plot=display

scalar Qr1 = ljungbox(st1, 10)
scalar pr1 = pvalue(X, 10, Qr1)
printf "Ljung-Box residui di r1: Q = %.4f, p = %.4f\n", Qr1, pr1

scalar Q2r1 = ljungbox((st1)^2, 10)
scalar p2r1 = pvalue(X, 10, Q2r1)
printf "Ljung-Box sui residui quadrati di r1: Q = %.4f, p = %.4f\n", Q2r1, p2r1

scalar Qr2 = ljungbox(st2, 10)
scalar pr2 = pvalue(X, 10, Qr2)
printf "Ljung-Box sui residui di r2: Q = %.4f, p = %.4f\n", Qr2, pr2

scalar Q2r2 = ljungbox((st2)^2, 10)
scalar p2r2 = pvalue(X, 10, Q2r2)
printf "Ljung-Box sui residui quadrati di Price2: Q = %.4f, p = %.4f\n", Q2r2, p2r2

scalar Qr3 = ljungbox(st3, 10)
scalar pr3 = pvalue(X, 10, Qr3)
printf "Ljung-Box sui residui di r3: Q = %.4f, p = %.4f\n", Qr3, pr3

scalar Q2r3 = ljungbox((st3)^2, 10)
scalar p2r3 = pvalue(X, 10, Q2r3)
printf "Ljung-Box sui residui quadrati di r3: Q = %.4f, p = %.4f\n", Q2r3, p2r3

normtest st1 --jbera 
normtest st2 --jbera
normtest st3 --jbera

# --- STEP 2 ESTIMATION -------------------------------

scalar has_target = 1
modeltype = 3 # 0 = unrestricted, 1 = Cholesky, 2 = rank-1, 3 = scalar
bundle DModel = DCC_Setup(E, H, modeltype, has_target)
DCC_Estimate(&DModel)
DCC_Printout(DModel) 

list C = DCC_GetCorrel(DModel)

# ======= PLOT DELLE VOLATILITÀ (GARCH-DCC) =======

series sd_r1 = sqrt(h_r1)
series sd_r2 = sqrt(h_r2)
series sd_r3 = sqrt(h_r3)

gnuplot sd_r1 sd_r2 sd_r3 \
    --time-series --with-lines \
   { set key top left, set title "Conditional volatility (GARCH–DCC) rank-1 Specification", set ylabel "σ_t" } \
  --output=display

#===============BEKK=====================

set verbose off
include BEKK.gfn

# --- DATA PREPARATION -----------------------------------------------

list Prices = Price1 Price2 Price3
list Returns = ldiff(Prices)

# --- MODEL SETUP AND ESTIMATION -------------------------------------

# setup the BEKK model 
scalar VAR_lags = 4
list VAR_exog = const
bundle Model = BEKK_Setup(Returns, VAR_lags, VAR_exog)

Model.vcvtype = 1

set bfgs_verbskip 25

BEKK_Estimate(&Model, 1)
BEKK_Printout(&Model)

# --- POSTESTIMATION -------------------------------------------------

series llik = BEKK_GetLoglik(&Model)

scalar k = 1
loop foreach i Prices
    series v_$i = BEKK_GetVariance(&Model, k++)
endloop

series cov12 = BEKK_GetCovariance(&Model, 1, 2)

scalar k = 1
loop foreach i Prices
    series u_$i = BEKK_GetResids(&Model, k++, 1)
endloop

BEKK_ComboPlot(Model)

# =========================================================
# ANALISI DEI RESIDUI
# =========================================================
# ACF sui residui
corrgm u_Price1 20 --plot=display
corrgm u_Price2 20 --plot=display
corrgm u_Price3 20 --plot=display

# Test di autocorrelazione (Ljung–Box) sui residui
scalar LjungBox1 = ljungbox(u_Price1, 20)
scalar Pvalue1 = pvalue(X, 20 , LjungBox1)
printf "Ljung–Box1(20): Q = %.4f, p-value = %.4f\n", LjungBox1, Pvalue1

scalar LjungBox2 = ljungbox(u_Price2, 20)
scalar Pvalue2 = pvalue(X, 20 , LjungBox2)
printf "Ljung–Box2(20): Q = %.4f, p-value = %.4f\n", LjungBox2, Pvalue2


scalar LjungBox3 = ljungbox(u_Price3, 20)
scalar Pvalue3 = pvalue(X, 20 , LjungBox3)
printf "Ljung–Box3(20): Q = %.4f, p-value = %.4f\n", LjungBox3, Pvalue3

# Normalità dei residui standardizzati (Jarque–Bera)
normtest u_Price1 --jbera
normtest u_Price2 --jbera
normtest u_Price3 --jbera

# Matrice di correlazione dei residui standardizzati
printf "\n================ Correlazione tra i residui standardizzati z_i ================\n"

corr u_Price1 u_Price2 u_Price3

# Spillover residuo:
# Ljung–Box sui prodotti u_i * u_j.
# -------------------------------------------------------------------
series u_R1_R2 = u_Price1 * u_Price2
series u_R1_R3 = u_Price1 * u_Price3
series u_R2_R3 = u_Price2 * u_Price3
printf "\n== Ljung–Box su prodotti dei residui (spillover) ==\n"
scalar LjungBox12 = ljungbox(u_R1_R2, 10)
scalar Pvalue12 = pvalue(X, 10 , LjungBox12)
printf "Ljung–Box12(10): Q = %.4f, p-value = %.4f\n", LjungBox12, Pvalue12
scalar LjungBox13 = ljungbox(u_R1_R3, 10)
scalar Pvalue13 = pvalue(X, 10 , LjungBox13)
printf "Ljung–Box13(10): Q = %.4f, p-value = %.4f\n", LjungBox13, Pvalue13
scalar LjungBox23 = ljungbox(u_R2_R3, 10)
scalar Pvalue23 = pvalue(X, 10 , LjungBox23)
printf "Ljung–Box23(10): Q = %.4f, p-value = %.4f\n", LjungBox23, Pvalue23

# Grafici diagnostici rapidi:

gnuplot u_Price1 --with-lines --time-series --output=display \
  {set title="Residui standardizzati: u_Price1"}
gnuplot u_Price2 --with-lines --time-series --output=display \
  {set title="Residui standardizzati: u_Price2"}
gnuplot u_Price3 --with-lines --time-series --output=display \
  {set title="Residui standardizzati: u_Price3"}

# QQ-plot rispetto alla normale
qqplot u_Price1 --output=display
qqplot u_Price2 --output=display
qqplot u_Price3 --output=display
